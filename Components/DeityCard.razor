@using KemeticReference.Models

<a class="deity-tile"
   href="@($"/deities/{Deity.Id}")">

    <span class="deity-tile-name">
        @Deity.Name
    </span>

    <img class="deity-tile-image"
         src="@($"/images/deities/{Deity.Id}.png")"
         alt=""
         loading="lazy" />
</a>

@code {
    [Parameter, EditorRequired]
    public Deity Deity { get; set; } = default!;
}