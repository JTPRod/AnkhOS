@page "/crystals"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text.Json
@using KemeticReference.Models
@inject IWebHostEnvironment Environment
@inject KemeticReference.Services.DeitySearchState Search

<PageTitle>Crystals</PageTitle>

<div class="crystals-page">
    <img src="images/crystal-Images/Egyptian Sunset Gemstone Altar.png"
         alt="Egyptian Sunset Gemstone Altar"
         class="crystal-banner" />

    @if (isLoading)
    {
        <p>Loading crystals...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <p role="alert">@errorMessage</p>
    }
    else if (crystals.Count == 0)
    {
        <p>No crystals found.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Search.Query))
        {
            <p class="search-summary">
                Results for “@Search.Query”
                <button class="clear-search"
                        type="button"
                        @onclick="ClearSearch">
                    Clear search
                </button>
            </p>
        }

        <div class="crystal-grid">
            @foreach (var crystal in FilteredCrystals)
            {
                <CrystalCard Crystal="crystal" @key="crystal.id" />
            }
        </div>

        @if (!FilteredCrystals.Any())
        {
            <p>No matching crystals found.</p>
        }
    }
</div>

@code {
    private List<Crystal> crystals = new();
    private bool isLoading = true;
    private string errorMessage = "";

    private IEnumerable<Crystal> FilteredCrystals
    {
        get
        {
            var query = Search.Query.Trim();

            return crystals.Where(crystal =>
                (crystal.crystalName ?? "").Contains(
                    query,
                    StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Search.Changed += HandleSearchChanged;

        try
        {
            string filePath = Path.Combine(
                Environment.ContentRootPath,
                "Data",
                "Reference",
                "crystals.json");

            string json = await File.ReadAllTextAsync(filePath);

            crystals = JsonSerializer.Deserialize<List<Crystal>>(
                json,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<Crystal>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load crystals: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleSearchChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearSearch()
    {
        Search.SetQuery("");
    }

    public void Dispose()
    {
        Search.Changed -= HandleSearchChanged;
    }
}