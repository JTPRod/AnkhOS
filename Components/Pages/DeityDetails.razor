@page "/deities/{Id}"

@rendermode InteractiveServer

@using KemeticReference.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using KemeticReference.Data
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject KemeticReference.Services.DeityService Catalog
@inject ILogger<DeityDetails> Logger
@inject IHostEnvironment Environment

<a class="back-link" href="/">‹ Back</a>

@if (failed)
{
    <p role="alert">Deity information could not be loaded.</p>
}
else if (loading)
{
    <p>Loading deity…</p>
}
else if (deity is null)
{
    <h1>Deity not found</h1>
}
else
{
    <PageTitle>AnkhOS — @deity.Name</PageTitle>

    <div class="deity-detail">
        <header class="deity-name-banner">
            <h1>@deity.Name</h1>
            @if (userId is not null)
            {
                <button type="button"
                        @onclick="ToggleFavoriteAsync"
                        disabled="@savingFavorite">
                    @(savingFavorite
                                ? "Saving…"
                                : isFavorite ? "Unfavorite" : "Favorite")
                </button>
            }
            else
            {
                <a href="/Account/Login">Log in to favorite</a>
            }

            @if (!string.IsNullOrWhiteSpace(deity.EgyptianName))
            {
                <span class="egyptian-name">
                    @deity.EgyptianName
                </span>
            }
        </header>

        <div class="deity-detail-grid">
            <div class="deity-information">
                <div class="information-panel">
                    <details class="deity-dropdown">
                        <summary>
                            <span>Crystals</span>
                        </summary>

                        <div class="dropdown-content">
                            @if (deityCrystals.Count == 0)
                            {
                                <p class="empty-crystals">No crystals listed.</p>
                            }
                            else
                            {
                                <div class="crystal-grid">
                                    @foreach (var crystal in deityCrystals)
                                    {
                                        <a class="crystal-link" href="@($"/crystals?search={Uri.EscapeDataString(crystal.crystalName)}")">
                                        <article class="crystal-preview">
                                            <img src="@($"/{crystal.img.TrimStart('/')}")"
                                                 alt="@crystal.crystalName"
                                                 loading="lazy" />

                                            <h3>@crystal.crystalName</h3>
                                        </article>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                    <details class="deity-dropdown">
                        <summary>
                            <span>Symbols</span>
                        </summary>

                        <div class="dropdown-content">
                            @if (deitySymbols.Count == 0)
                            {
                                <p class="empty-crystals">No symbols listed.</p>
                            }
                            else
                            {
                                <div class="crystal-grid">
                                    @foreach (var symbol in deitySymbols)
                                    {
                                        <article class="crystal-preview">
                                            <img src="@($"/{symbol.img1.TrimStart('/')}")"
                                                 alt="@symbol.symbolName"
                                                 loading="lazy" />

                                            <h3>@symbol.symbolName</h3>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    </details>

                    <DeityDropdown Title="Devotional Acts"
                                   Entries="deity.DevotionalActs" />

                    <DeityDropdown Title="Divination Methods"
                                   Entries="deity.DivinationMethods" />

                    <DeityDropdown Title="Worship Practices"
                                   Entries="deity.WorshipPractices" />

                    <DeityDropdown Title="Offerings"
                                   Entries="deity.Offerings" />

                    <details class="deity-dropdown">
                        <summary>
                            <span>Stories/Lore</span>
                        </summary>

                        <div class="dropdown-content">
                            @if (deityStory is null)
                            {
                                <p>No story available.</p>
                            }
                            else
                            {
                                <article class="information-entry">
                                    <p class="story-lore">@deityStory.lore</p>
                                </article>
                            }
                        </div>
                    </details>
                </div>

                <section class="sources-panel" id="sources">
                    <h2>Sources</h2>

                    @if (deity.Sources.Count == 0)
                    {
                        <p>No reviewed sources added yet.</p>
                    }

                    @foreach (var source in deity.Sources)
                    {
                        <article id="@($"source-{source.Id}")">
                            <h3>@source.Title</h3>

                            <p>
                                @source.Author
                                — @source.PublicationDetails
                            </p>

                            @if (source.Url is not null)
                            {
                                <a href="@source.Url">Read source</a>
                            }
                        </article>
                    }

                    <p class="review-date">
                        Last reviewed:
                        @(deity.LastReviewed?.ToString("yyyy-MM-dd")
                            ?? "Not reviewed")
                    </p>
                </section>
            </div>

            <div class="deity-artwork">
                <img src="@($"/images/deities/{deity.Id}.png")"
                     alt="@($"Illustration of {deity.Name}")" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private List<Crystal> deityCrystals = [];
    private List<Symbol> deitySymbols = [];

    private Deity? deity;
    private Story? deityStory;
    private bool loading = true;
    private bool failed;
    // Keep your existing fields and methods.
    private string? userId;
    private bool isFavorite;
    private bool savingFavorite;

    private async Task LoadFavoriteStateAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = UserManager.GetUserId(authState.User);
        isFavorite = false;

        if (userId is null)
            return;

        // Assumes Deity.Link is the local route, e.g. "/deities/isis".
        var databaseDeity = await Db.Deities
            .AsNoTracking()
            .FirstOrDefaultAsync(d => d.Link == $"/deities/{Id}");

        if (databaseDeity is not null)
        {
            isFavorite = await Db.UserFavorites.AnyAsync(f =>
                f.UserId == userId &&
                f.DeityId == databaseDeity.Id);
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        if (userId is null || savingFavorite)
            return;

        savingFavorite = true;

        try
        {
            var databaseDeity = await Db.Deities
                .FirstOrDefaultAsync(d => d.Link == $"/deities/{Id}");

            if (databaseDeity is null)
                return;

            var favorite = await Db.UserFavorites.FirstOrDefaultAsync(f =>
                f.UserId == userId &&
                f.DeityId == databaseDeity.Id);

            if (favorite is null)
            {
                Db.UserFavorites.Add(new UserFavorite
                {
                    UserId = userId,
                    DeityId = databaseDeity.Id
                });
                isFavorite = true;
            }
            else
            {
                Db.UserFavorites.Remove(favorite);
                isFavorite = false;
            }

            await Db.SaveChangesAsync();
        }
        finally
        {
            savingFavorite = false;
        }
    }

    
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        failed = false;
        deity = null;
        deityCrystals = [];
        deitySymbols = [];
        deityStory = null;

        try
        {
            deity = await Catalog.GetByIdAsync(Id);

            if (deity is not null)
            {
                await LoadFavoriteStateAsync();

                string storyFilePath = Path.Combine(
                    Environment.ContentRootPath,
                    "Data",
                    "Reference",
                    "story.json");

                string storyJson = await File.ReadAllTextAsync(storyFilePath);

                List<Story> storyCatalog =
                    JsonSerializer.Deserialize<List<Story>>(
                        storyJson,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        }) ?? [];

                deityStory = storyCatalog.FirstOrDefault(story =>
                    string.Equals( story.storyId, deity.Id,                        StringComparison.OrdinalIgnoreCase));
            }

            if (deity is not null && deity.Crystals.Count > 0)
            {
                string filePath = Path.Combine(
                    Environment.ContentRootPath,
                    "Data",
                    "Reference",
                    "crystals.json");

                string json = await File.ReadAllTextAsync(filePath);

                List<Crystal> crystalCatalog =
                    JsonSerializer.Deserialize<List<Crystal>>(
                        json,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        }) ?? [];

                deityCrystals = crystalCatalog
                    .Where(crystal => deity.Crystals.Contains(
                        crystal.crystalName,
                        StringComparer.OrdinalIgnoreCase))
                    .ToList();
            }
            if (deity is not null)
            {
                try
                {
                    string symbolFilePath = Path.Combine(
                        Environment.ContentRootPath,
                        "Data",
                        "Reference",
                        "symbols.json");

                    string symbolJson = await File.ReadAllTextAsync(symbolFilePath);

                    List<Symbol> symbolCatalog =
                        JsonSerializer.Deserialize<List<Symbol>>(
                            symbolJson,
                            new JsonSerializerOptions
                            {
                                PropertyNameCaseInsensitive = true
                            }) ?? [];

                    deitySymbols = symbolCatalog
     .Where(symbol => deity.Symbols != null
         && deity.Symbols.Any(name =>
             string.Equals(
                 name,
                 symbol.symbolName,
                 StringComparison.OrdinalIgnoreCase)
             || string.Equals(
                 name,
                 symbol.id,
                 StringComparison.OrdinalIgnoreCase)))
     .ToList();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Could not load deity symbols.");
                    deitySymbols = [];
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load deity profile.");
            failed = true;
        }
        finally
        {
            loading = false;
        }
    }

}
