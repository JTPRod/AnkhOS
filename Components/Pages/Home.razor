@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using KemeticReference.Models
@inject KemeticReference.Services.DeityService Catalog
@inject KemeticReference.Services.DeitySearchState Search
@inject ILogger<Home> Logger

<PageTitle>AnkhOS — Deities</PageTitle>

@if (failed)
{
    <p role="alert">
        Deity information could not be loaded.
    </p>
}
else if (deities is null)
{
    <p>Loading deities…</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Search.Query))
    {
        <p class="search-summary">
            Results for “@Search.Query”

            <button type="button"
                    class="clear-search"
                    @onclick="ClearSearch">
                Clear search
            </button>
        </p>
    }

    <div class="deity-grid">
        @foreach (var deity in FilteredDeities)
        {
            <DeityCard @key="deity.Id" Deity="deity" />
        }
    </div>

    @if (!FilteredDeities.Any())
    {
        <p>No matching deities found.</p>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private IReadOnlyList<Deity>? deities;
    private bool failed;

    private IEnumerable<Deity> FilteredDeities
    {
        get
        {
            var search = Search.Query.Trim();

            return (deities ?? Array.Empty<Deity>())
                .Where(deity =>
                    deity.Name.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    deity.AlternateNames.Any(name =>
                        name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Search.Changed += OnSearchChanged;

        try
        {
            deities = await Catalog.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load deity catalog.");
            failed = true;
        }
    }

    protected override void OnParametersSet()
    {
        Search.SetQuery(Query);
    }

    private void OnSearchChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearSearch()
    {
        Search.SetQuery("");
    }

    public void Dispose()
    {
        Search.Changed -= OnSearchChanged;
    }
}