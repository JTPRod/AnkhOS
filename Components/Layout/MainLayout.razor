@inherits LayoutComponentBase

<div class="ankh-layout">
    <header class="ankh-header">
        <a class="brand" href="/">
            <img class="brand-logo"
                 src="/images/AnkhOS.png"
                 alt="" />
            AnkhOS
        </a>

        <form class="header-search" action="/" method="get">
            <input type="search"
                   name="q"
                   placeholder="Search"
                   aria-label="Search deities" />

            <button type="submit" aria-label="Search">
                &#128269;
            </button>
        </form>

        <AuthorizeView>
            <Authorized>
                <a class="profile-link" href="/my-profile">
                    My profile
                    <span aria-hidden="true">●</span>
                </a>
            </Authorized>

            <NotAuthorized>
                <a class="profile-link" href="/Account/Login">
                    Sign in
                    <span aria-hidden="true">●</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="ankh-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <a class="dismiss">✕</a>
</div>