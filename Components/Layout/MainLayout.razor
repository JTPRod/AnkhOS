@inherits LayoutComponentBase

<div class="ankh-layout">
    <header class="ankh-header">
        <a class="brand" href="/">
            <img class="brand-logo"
                 src="/images/AnkhOS.png"
                 alt="" />
            AnkhOS
        </a>

        <DeitySearchBar />

        <AuthorizeView>
            <Authorized Context="auth">
                <a class="profile-link" href="/my-profile">
                    <span>@auth.User.Identity?.Name</span>

                    <img class="profile-avatar"
                         src="/images/default-profile.png"
                         alt="Profile" />
                </a>
            </Authorized>

            <NotAuthorized>
                <a class="profile-link" href="/Account/Login">
                    <span>Sign in</span>

                    <img class="profile-avatar"
                         src="/images/default-profile.png"
                         alt="" />
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="ankh-content">
        <nav class="section-navigation" aria-label="Explore AnkhOS">
            <NavLink href="/" Match="NavLinkMatch.All">
                Deities
            </NavLink>

            <NavLink href="/crystals">
                Crystals
            </NavLink>

            <NavLink href="/stories">
                Stories / Lore
            </NavLink>

            <NavLink href="/symbols">
                Symbols
            </NavLink>

            <NavLink href="/locations">
                Historical Locations
            </NavLink>
        </nav>

        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <a class="dismiss">✕</a>
</div>