@using KemeticReference.Models

<details class="deity-dropdown">
    <summary>@Title</summary>

    <div class="dropdown-content">
        @if (Entries.Count == 0)
        {
            <p>No reviewed information available.</p>
        }
        else
        {
            @foreach (var entry in Entries)
            {
                <article class="information-entry">
                    <p>@entry.Text</p>

                    @if (!string.IsNullOrWhiteSpace(entry.EvidenceType))
                    {
                        <p class="entry-context">
                            @entry.EvidenceType
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(entry.Context))
                    {
                        <p class="entry-context">
                            @entry.Context
                        </p>
                    }

                    @if (entry.SourceIds.Count > 0)
                    {
                        <div class="entry-sources">
                            Sources:
                            @foreach (var sourceId in entry.SourceIds)
                            {
                                <a href="@($"#source-{sourceId}")">
                                    @sourceId
                                </a>
                            }
                        </div>
                    }
                </article>
            }
        }
    </div>
</details>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public List<ContentEntry> Entries { get; set; } = [];
}